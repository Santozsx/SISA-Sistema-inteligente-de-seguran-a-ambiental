# Copie para .env e troque os valores. Nunca suba o .env para o GitHub.

# Gere valores aleatórios com:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SISA_JWT_SEGREDO=troque-por-um-valor-aleatorio
SISA_CHAVE_MESTRA=troque-por-outro-valor-aleatorio

# Duração do login, em minutos
SISA_JWT_EXPIRACAO_MINUTOS=120

# Cifra dos dados guardados: "sisa" (proposta da equipe) ou "aes-gcm"
SISA_CIFRA_PADRAO=sisa
# Cifra dos anexos (imagens). AES-GCM é bem mais rápida para arquivos grandes.
SISA_CIFRA_ANEXOS=sisa
SISA_TAMANHO_MAXIMO_ANEXO_MB=5

# Banco de dados (padrão: backend/sisa.db)
# SISA_DATABASE_URL=sqlite:///./sisa.db

# Origens liberadas (front Vite e Expo Web), separadas por vírgula
SISA_CORS_ORIGENS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081

# true = só institutos com verificado=True conseguem entrar
SISA_EXIGIR_VERIFICACAO=false

# Versão mínima do app mobile aceita pela API
SISA_VERSAO_MINIMA_APP=1.0.0
